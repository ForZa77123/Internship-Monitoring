# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# For local: postgresql://USER:PASSWORD@localhost:5432/internship_monitor
# For Supabase: copy from Project Settings > Database > Connection string (URI mode)
DATABASE_URL="postgresql://user:password@localhost:5432/internship_monitor"
DIRECT_URL="postgresql://user:password@localhost:5432/internship_monitor"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Presence Webhook & AI Sync ──────────────────────────────────────────────
# Shared secret for the /api/presence and /api/sync-logs endpoints.
# The Python AI module must include this as: X-API-Secret: <value>
PRESENCE_API_SECRET="your-webhook-secret-here"

# External AI Camera API endpoint polled every 60s by the built-in scheduler
AI_LOGS_URL="http://192.168.8.186:5000/api/logs"

# External AI Camera MJPEG video stream server (core_monitoring.py on port 5001)
NEXT_PUBLIC_STREAM_SERVER_URL="http://127.0.0.1:5001"
