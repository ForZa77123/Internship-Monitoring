# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# For local: postgresql://USER:PASSWORD@localhost:5432/internship_monitor
# For Supabase: copy from Project Settings > Database > Connection string (URI mode)
DATABASE_URL="postgresql://user:password@localhost:5432/internship_monitor"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Presence Webhook ────────────────────────────────────────────────────────
# Shared secret for the /api/presence endpoint.
# The Python AI module must include this as: X-API-Secret: <value>
PRESENCE_API_SECRET="your-webhook-secret-here"
