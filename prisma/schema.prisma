// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  INTERN
}

enum PresenceStatus {
  ACTIVE
  IDLE
  AWAY
}

enum ValidationStatus {
  APPROVED
  REJECTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(INTERN)
  department   String?       // Intern specialization (UI/UX, Front End, etc.)
  presenceLogs PresenceLog[]
  activityLogs ActivityLog[]
  validatedLogs ActivityLog[] @relation("ValidatedActivities")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model PresenceLog {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    PresenceStatus
  timestamp DateTime       @default(now())

  @@index([userId, timestamp])
  @@map("presence_logs")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTitle   String
  description String   @db.Text
  startTime   DateTime
  endTime     DateTime
  isValidated Boolean  @default(false)
  // ADMIN can approve or reject a log with an optional note
  validationStatus ValidationStatus?
  validationNote   String? @db.Text
  validatedAt      DateTime?
  validatedById    String?
  validatedBy      User?    @relation("ValidatedActivities", fields: [validatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("activity_logs")
}
